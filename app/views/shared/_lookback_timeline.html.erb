<%
# locals: timeline (Fogbell::LookbackTimeline), size (:small|:medium|:standalone, default :medium)
size = local_assigns.fetch(:size, :medium)
cfg = {
  small:      { cell: "h-7", radius: "rounded-sm", gap: "gap-0.5", dot: "w-2.5 h-2.5", stranded: "w-2.5 h-2.5 border-2", ard: "border-r-4", captions: false, numbers_above: false },
  medium:     { cell: "h-14", radius: "rounded-sm", gap: "gap-0.5", dot: "w-3.5 h-3.5", stranded: "w-3.5 h-3.5 border-2", ard: "border-r-4", captions: true, numbers_above: true },
  standalone: { cell: "h-[88px]", radius: "rounded", gap: "gap-[3px]", dot: "w-5 h-5", stranded: "w-5 h-5 border-[2.5px]", ard: "border-r-[6px]", captions: true, numbers_above: true }
}.fetch(size)
grid_style = "grid-template-columns: repeat(#{timeline.column_count}, minmax(0,1fr));"
%>
<div class="lookback-timeline" role="img" aria-label="<%= timeline.summary %>">
  <% unless timeline.computable? %>
    <p class="text-xs italic text-muted">Look-back window not stated for this item.</p>
  <% else %>
    <div class="flex flex-col <%= cfg[:gap] %>">
      <% if cfg[:numbers_above] %>
        <div class="grid <%= cfg[:gap] %> text-[11px] font-semibold text-faint" style="<%= grid_style %>">
          <% prev_month = nil %>
          <% timeline.days.each do |day| %>
            <% show_month = prev_month != day.date.month; prev_month = day.date.month %>
            <div class="<%= day.is_ard ? 'text-right text-ink' : day.is_today ? 'text-closing' : day.date == timeline.window_first_day ? 'text-body' : '' %>"><%= show_month ? day.date.strftime("%b %-d") : day.date.strftime("%-d") %></div>
          <% end %>
        </div>
      <% end %>

      <div class="grid <%= cfg[:gap] %>" style="<%= grid_style %>">
        <% timeline.days.each do |day| %>
          <div class="flex items-center justify-center gap-0.5 <%= cfg[:radius] %> <%= cfg[:cell] %> <%= day.in_window ? 'bg-window' : 'bg-ground' %> <%= 'border-r-4 border-ink' if day.is_ard && size != :standalone %> <%= 'border-r-[6px] border-ink' if day.is_ard && size == :standalone %> <%= 'outline outline-2 -outline-offset-2 outline-closing' if day.is_today %>">
            <% day.entries.each do %>
              <span class="<%= cfg[:dot] %> rounded-full bg-ink" aria-hidden="true"></span>
            <% end %>
            <% day.outside_entries.each do %>
              <span class="<%= cfg[:stranded] %> rounded-full border-dashed border-muted" aria-hidden="true"></span>
            <% end %>
            <span class="sr-only"><%= (day.entries + day.outside_entries).size %> note(s) on <%= day.date.iso8601 %></span>
          </div>
        <% end %>
      </div>

      <% if cfg[:captions] %>
        <div class="grid <%= cfg[:gap] %> text-[11px] leading-[1.35] text-muted" style="<%= grid_style %>">
          <% timeline.days.each do |day| %>
            <div class="<%= 'text-right' if day.is_ard %>">
              <% if day.plotted? %>
                <% e = (day.entries + day.outside_entries).first %>
                <span class="font-semibold <%= 'text-ink' if day.in_window %>"><%= e["author"] %></span><br><%= day.in_window ? "#{(day.entries.size)} note#{'s' unless day.entries.size == 1}" : "outside window" %>
              <% elsif day.is_today %>
                <span class="font-semibold text-closing">Today</span>
              <% elsif day.is_ard %>
                <span class="font-semibold text-ink">ARD</span>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="grid grid-cols-[2fr_5fr_2fr] text-[10px] font-medium text-faint">
          <div><%= timeline.range_first_day.strftime("%b %-d") %></div>
          <div class="text-body"><%= timeline.window_first_day.strftime("%b %-d") %> – <%= timeline.last_day.strftime("%b %-d") %></div>
          <div class="text-right text-ink">ARD <%= timeline.last_day.strftime("%b %-d") %></div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
