<%# locals: source (a {"doc"=>, "loc"=>, "quote"=>} citation hash) %>
<div class="flex flex-col gap-1.5 rounded bg-ground px-4 py-3">
  <% if source["quote"].present? %>
    <p class="text-sm leading-relaxed text-ink">&ldquo;<%= source["quote"] %>&rdquo;</p>
  <% else %>
    <p class="text-sm italic leading-relaxed text-muted">[verbatim quote from source — supplied by rule extraction]</p>
  <% end %>
  <p class="text-xs font-semibold text-meta"><%= cite(source) %></p>
</div>
