<% content_for :title, "Fogbell — #{@assessment.resident.label} assessment" %>
<%
item = @assessment.focus_item
finding = @assessment.finding
days = @assessment.days_remaining
%>

<div class="flex flex-col gap-6">
  <div class="flex flex-wrap items-start justify-between gap-6">
    <div class="flex flex-col gap-1">
      <p class="text-[13px] font-medium text-muted"><%= link_to @assessment.resident.label, resident_path(@assessment.resident), class: "hover:underline" %> · <%= @assessment.assessment_type.tr("_", " ") %></p>
      <h1 class="text-3xl font-semibold leading-none tracking-tight"><%= item&.item_name %></h1>
      <p class="text-sm text-body">ARD <%= @assessment.ard.strftime("%b %-d, %Y") %></p>
    </div>
    <div class="flex shrink-0 items-center gap-2">
      <%= @assessment.closed? ? badge("closed", label: "Closed #{@assessment.ard.strftime('%b %-d')}") : deadline_badge(days) %>
      <%= primary_button "Open check", new_check_path(assessment_id: @assessment.id) %>
    </div>
  </div>

  <% if item && finding %>
    <div class="rounded border border-rule bg-white p-6">
      <div class="mb-4 flex flex-wrap items-center gap-2">
        <%= link_to item.item_id, rulebook_item_path(item.item_id), class: "font-mono text-xs font-semibold text-ink hover:underline" %>
        <%= verdict_badge(finding["status"]) %>
      </div>
      <%= render "shared/lookback_timeline", size: :medium, timeline: Fogbell::LookbackTimeline.new(
            ard: @assessment.ard, lookback_days: finding.dig("window", "days") || item.lookback_days,
            evidence: finding["evidence"], outside_window_evidence: finding["outside_window_evidence"]
          ) %>
      <p class="mt-4 text-sm leading-relaxed text-body"><%= finding["rationale"] %></p>
    </div>
  <% else %>
    <p class="text-sm italic text-muted">No pre-run check for this window yet.</p>
  <% end %>
</div>
