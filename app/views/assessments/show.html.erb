<% content_for :title, "Fogbell — #{@assessment.resident.label} assessment" %>
<%
item = @assessment.focus_item
finding = @assessment.finding
%>

<div class="mb-6">
  <%= link_to "← Today", today_path, class: "text-sm text-slate-500 hover:text-slate-700" %>
</div>

<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <div>
    <p class="text-sm text-slate-500"><%= link_to @assessment.resident.label, resident_path(@assessment.resident), class: "hover:underline" %></p>
    <h1 class="mt-1 text-2xl font-semibold tracking-tight text-slate-900"><%= @assessment.assessment_type.tr("_", " ").capitalize %></h1>
    <p class="mt-1 text-sm text-slate-500">ARD <%= @assessment.ard.strftime("%b %-d, %Y") %> · <%= @assessment.open? ? "closes in #{@assessment.days_remaining} days" : "closed" %></p>
  </div>
  <%= link_to "Open check", new_check_path(assessment_id: @assessment.id), class: "rounded-md bg-slate-900 px-3 py-2 text-xs font-semibold text-white shadow-sm hover:bg-slate-800" %>
</div>

<% if item && finding %>
  <div class="rounded-lg border border-slate-200 bg-white p-5">
    <div class="flex flex-wrap items-center gap-2">
      <%= link_to item.item_id, rulebook_item_path(item.item_id), class: "font-mono text-xs font-semibold text-slate-700 hover:underline" %>
      <span class="text-sm text-slate-800"><%= item.item_name %></span>
      <%= status_badge(finding["status"]) %>
    </div>
    <div class="mt-4">
      <%= render "shared/lookback_timeline", timeline: Fogbell::LookbackTimeline.new(
            ard: @assessment.ard, lookback_days: finding.dig("window", "days") || item.lookback_days,
            evidence: finding["evidence"], outside_window_evidence: finding["outside_window_evidence"]
          ) %>
    </div>
    <p class="mt-4 text-sm text-slate-700"><%= finding["rationale"] %></p>
  </div>
<% else %>
  <p class="text-sm text-slate-500 italic">No pre-run check for this window yet.</p>
<% end %>
