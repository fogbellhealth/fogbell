<!DOCTYPE html>
<html lang="en" class="h-full bg-paper">
  <head>
    <title><%= content_for(:title) || "Fogbell — evidence check" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-full font-sans text-ink tabular-nums antialiased">
    <% dark_header = user_signed_in? && content_for?(:dark_header) %>
    <header class="border-b border-rule <%= dark_header ? 'bg-ink text-white' : 'bg-white' %>">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-8 py-3.5">
        <div class="flex flex-wrap items-center gap-6">
          <%= link_to root_path, class: "flex items-center gap-2 no-underline" do %>
            <span class="h-[13px] w-[13px] rounded-t-full rounded-b-sm <%= dark_header ? 'bg-white' : 'bg-ink' %>" aria-hidden="true"></span>
            <span class="text-lg font-bold tracking-tight <%= dark_header ? 'text-white' : 'text-ink' %>">Fogbell<% if dark_header %> <span class="font-medium text-faint">Review</span><% end %></span>
          <% end %>
          <% if user_signed_in? && !dark_header %>
            <nav class="flex flex-wrap gap-5 text-sm font-medium text-muted">
              <% if current_user.facility_domain? %>
                <%= link_to "Today", today_path, class: "pb-0.5 #{current_page?(today_path) ? 'border-b-2 border-ink font-semibold text-ink' : ''}" %>
                <%= link_to "Residents", residents_path, class: "pb-0.5 #{controller_name == 'residents' ? 'border-b-2 border-ink font-semibold text-ink' : ''}" %>
              <% end %>
              <%= link_to "Rules", rulebook_path, class: "pb-0.5 #{controller_name == 'rulebook' ? 'border-b-2 border-ink font-semibold text-ink' : ''}" %>
              <%= link_to "Changes", changes_path, class: "pb-0.5 #{current_page?(changes_path) ? 'border-b-2 border-ink font-semibold text-ink' : ''}" %>
            </nav>
          <% end %>
          <% if dark_header %>
            <div class="text-[13px] text-rule"><%= yield :header_subtitle %></div>
          <% end %>
        </div>
        <div class="flex items-center gap-3">
          <% if user_signed_in? %>
            <% if dark_header %>
              <div class="flex items-center gap-1.5 text-[13px] text-rule"><%= glyph(:square_outline) %>No resident data in this application</div>
              <span class="text-[13px] text-rule"><%= current_user.email %></span>
            <% else %>
              <%= badge("synthetic") %>
              <span class="text-[13px] text-body"><%= current_user.facility&.name %></span>
            <% end %>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "rounded px-2 py-1 text-xs font-medium #{dark_header ? 'text-rule hover:bg-white/10' : 'text-muted hover:bg-ground hover:text-body'}" %>
          <% end %>
        </div>
      </div>
    </header>
    <main class="mx-auto max-w-6xl <%= dark_header ? '' : 'p-8' %>">
      <% if notice %>
        <div class="mb-6 rounded border border-rule bg-window px-4 py-3 text-sm text-ink">
          <%= badge("verified") %> <%= notice %>
        </div>
      <% end %>
      <% if flash[:alert] %>
        <div class="mb-6 rounded border border-closing px-4 py-3 text-sm text-closing"><%= flash[:alert] %></div>
      <% end %>
      <%= yield %>
    </main>
    <% unless dark_header %>
      <footer class="mx-auto max-w-6xl px-8 pb-10 pt-4 text-xs leading-relaxed text-muted">
        <p><strong class="text-body">Demo only — synthetic data only. Never enter real resident information.</strong> Every finding on this site is a draft for nurse review, generated from public regulatory text with page citations. Rules drawn from state materials (Maine, New York) are provisional pending review by a state-qualified expert. Nothing here is coding advice, legal advice, or a substitute for the underlying manual or protocol.</p>
      </footer>
    <% end %>
  </body>
</html>
