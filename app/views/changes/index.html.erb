<% content_for :title, "Fogbell — rule changes" %>

<div class="mb-8 max-w-3xl">
  <h1 class="text-3xl font-semibold leading-none tracking-tight">Rule changes</h1>
  <p class="mt-2 text-sm leading-relaxed text-body">When a source document changes, or a new one is added to the corpus, it shows up here — with the exact passage, both versions, cited. Factual, not alarmist: a regulator revising its own protocol is normal; not knowing about it is the risk.</p>
</div>

<div class="flex flex-col gap-6">
  <% @entries.each do |entry| %>
    <article class="rounded border border-rule bg-white p-5">
      <header class="flex flex-wrap items-center gap-2 text-xs text-muted">
        <span class="font-semibold text-meta"><%= entry.date.strftime("%B %-d, %Y") %></span>
        <span aria-hidden="true">·</span>
        <span class="font-mono"><%= manifest.name(entry.document) %></span>
        <span class="rounded bg-ground px-1.5 py-0.5 font-medium text-body"><%= entry.kind == "revision" ? "Revision" : "Corpus addition" %></span>
      </header>
      <p class="mt-2 text-sm text-ink"><%= entry.summary %></p>

      <% if entry.diff.present? %>
        <div class="mt-4 flex flex-col gap-4">
          <% entry.diff.each do |d| %>
            <div>
              <p class="mb-1 text-[11px] font-semibold uppercase tracking-[.06em] text-muted"><%= d[:area] %></p>
              <div class="grid gap-3 md:grid-cols-2">
                <div class="rounded border border-rule bg-ground p-3">
                  <p class="mb-1 text-[11px] font-semibold text-muted"><%= d[:before][:label] %> · <%= d[:before][:loc] %></p>
                  <p class="whitespace-pre-line text-xs text-body"><%= d[:before][:quote] %></p>
                </div>
                <div class="rounded border border-ink bg-window p-3">
                  <p class="mb-1 text-[11px] font-semibold text-ink"><%= d[:after][:label] %> · <%= d[:after][:loc] %></p>
                  <p class="whitespace-pre-line text-xs text-ink"><%= d[:after][:quote] %></p>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if entry.item_ids.any? %>
        <div class="mt-4 flex flex-wrap items-center gap-2">
          <span class="text-xs text-muted">Affected items:</span>
          <% entry.item_ids.first(12).each do |id| %>
            <%= link_to id, rulebook_item_path(id), class: "rounded bg-ground px-2 py-0.5 font-mono text-xs text-body hover:bg-window" %>
          <% end %>
          <% if entry.item_ids.size > 12 %><span class="text-xs text-faint">+ <%= entry.item_ids.size - 12 %> more</span><% end %>
        </div>
      <% end %>
    </article>
  <% end %>
</div>
