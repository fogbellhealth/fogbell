<% content_for :title, "Fogbell — today" %>

<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <div>
    <p class="text-xs font-medium uppercase tracking-wider text-slate-400">Synthetic data — <%= @facility&.name || "no facility seeded" %></p>
    <h1 class="mt-1 text-2xl font-semibold tracking-tight text-slate-900"><%= pluralize(@closing_this_week, "window") %> closing this week</h1>
  </div>
</div>

<div class="mb-8 grid grid-cols-1 gap-3 sm:grid-cols-3">
  <div class="rounded-lg border border-slate-200 bg-white p-4">
    <p class="text-2xl font-semibold text-slate-900"><%= @assessments.size %></p>
    <p class="text-xs text-slate-500">windows open</p>
  </div>
  <div class="rounded-lg border border-slate-200 bg-white p-4">
    <p class="text-2xl font-semibold text-slate-900"><%= @needs_charting %></p>
    <p class="text-xs text-slate-500">items needing charting</p>
  </div>
  <div class="rounded-lg border border-slate-200 bg-white p-4">
    <% if @projection&.available? %>
      <p class="text-2xl font-semibold text-slate-900"><%= @projection.error_rate_pct %>%</p>
      <p class="text-xs text-slate-500">projected error rate <span class="text-slate-400">(<%= @projection.checked %> checked)</span></p>
    <% else %>
      <p class="text-2xl font-semibold text-slate-400">—</p>
      <p class="text-xs text-slate-500">projected error rate <span class="text-slate-400">(no checks run yet)</span></p>
    <% end %>
  </div>
</div>

<% if @assessments.empty? %>
  <div class="rounded-lg border border-slate-200 bg-white p-6 text-sm text-slate-500">
    No open assessment windows. Run <code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">rails db:seed</code> to load the synthetic facility.
  </div>
<% else %>
  <div class="space-y-4">
    <% @assessments.sort_by(&:days_remaining).each do |assessment| %>
      <%= render "today/card", assessment: assessment %>
    <% end %>
  </div>
<% end %>
