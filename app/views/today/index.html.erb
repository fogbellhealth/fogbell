<% content_for :title, "Fogbell — today" %>

<div class="flex flex-col gap-7">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div class="flex flex-col gap-1">
      <p class="text-[13px] font-medium text-muted"><%= @facility&.name %> · <%= Date.current.strftime("%A, %b %-d") %></p>
      <h1 class="text-3xl font-semibold leading-none tracking-tight"><%= pluralize(@closing_this_week, "window") %> closing this week</h1>
    </div>
    <%= render "shared/metric_group", metrics: [
          { label: "Windows open", value: @assessments.size },
          { label: "Items needing charting", value: @needs_charting },
          { label: "Projected error rate", value: @projection&.available? ? "#{@projection.error_rate_pct}%" : "—" }
        ] %>
  </div>

  <% if @assessments.empty? %>
    <div class="rounded border border-rule bg-white p-6 text-sm text-muted">
      No open assessment windows. Run <code class="rounded bg-ground px-1.5 py-0.5 text-xs">rails db:seed</code> to load the synthetic facility.
    </div>
  <% else %>
    <% sorted = @assessments.sort_by(&:days_remaining) %>
    <% shown, rest = sorted.first(3), sorted.drop(3) %>
    <div class="flex flex-col gap-3">
      <% shown.each do |assessment| %>
        <%= render "today/card", assessment: assessment %>
      <% end %>
    </div>
    <% if rest.any? %>
      <div class="flex items-center justify-between rounded border border-dashed border-rule px-6 py-3.5 text-sm text-body">
        <div><%= pluralize(rest.size, "more window") %> open · earliest closes in <%= rest.first.days_remaining %> days</div>
        <%= link_to "Show all #{sorted.size} →", residents_path, class: "font-semibold text-ink" %>
      </div>
    <% end %>
  <% end %>
</div>
