<%
resident = assessment.resident
item = assessment.focus_item
finding = assessment.finding
days = assessment.days_remaining
closes_text = days <= 0 ? "closes today" : days == 1 ? "closes tomorrow" : "closes in #{days} days"
%>
<article class="rounded-lg border border-slate-200 bg-white p-5" id="assessment_<%= assessment.id %>">
  <header class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <p class="text-sm font-semibold text-slate-900"><%= resident.label %> <span class="ml-1 font-normal text-slate-500"><%= assessment.assessment_type.tr("_", " ").capitalize %></span></p>
      <p class="mt-0.5 text-xs text-slate-500">ARD <%= assessment.ard.strftime("%b %-d, %Y") %></p>
    </div>
    <span class="rounded-md px-2.5 py-1 text-xs font-semibold <%= days <= 2 ? 'bg-rose-50 text-rose-800 ring-1 ring-inset ring-rose-200' : 'bg-slate-100 text-slate-700' %>"><%= closes_text %></span>
  </header>

  <% if item && finding %>
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <%= link_to item.item_id, rulebook_item_path(item.item_id), class: "font-mono text-xs font-semibold text-slate-700 hover:underline" %>
      <span class="text-sm text-slate-800"><%= item.item_name %></span>
      <%= status_badge(finding["status"]) %>
    </div>

    <div class="mt-3 rounded-md bg-slate-50/60 px-3 py-2">
      <%= render "shared/lookback_timeline", compact: true, timeline: Fogbell::LookbackTimeline.new(
            ard: assessment.ard, lookback_days: finding.dig("window", "days") || item.lookback_days,
            evidence: finding["evidence"], outside_window_evidence: finding["outside_window_evidence"]
          ) %>
    </div>

    <p class="mt-3 text-sm text-slate-700"><%= finding["rationale"] %></p>
    <% if finding["gaps"].present? && finding["gaps"].any? %>
      <p class="mt-1 text-xs text-amber-800">Gap: <%= finding["gaps"].first %></p>
    <% end %>
  <% else %>
    <p class="mt-3 text-sm text-slate-500 italic">No pre-run check for this window yet.</p>
  <% end %>

  <div class="mt-4 flex items-center gap-3">
    <%= link_to "Open check", new_check_path(assessment_id: assessment.id), class: "rounded-md bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white shadow-sm hover:bg-slate-800" %>
    <% if item %><%= link_to "See the rule", rulebook_item_path(item.item_id), class: "text-xs font-medium text-slate-600 hover:underline" %><% end %>
  </div>
</article>
