<%
resident = assessment.resident
item = assessment.focus_item
finding = assessment.finding
days = assessment.days_remaining
%>
<article class="grid grid-cols-[1fr_300px] rounded border border-rule bg-white" id="assessment_<%= assessment.id %>">
  <div class="flex flex-col gap-3.5 border-r border-rule px-6 py-5">
    <div class="flex flex-col gap-1">
      <div class="text-[17px] font-semibold"><%= resident.label %> <span class="font-medium text-muted">· <%= assessment.assessment_type.tr("_", " ") %></span></div>
      <div class="text-sm leading-snug text-body">
        <% if item %><span class="font-semibold text-ink"><%= item.item_id %></span> <%= item.item_name.downcase %><% if item.lookback_days %> · <%= item.lookback_days %>-day look-back<% end %><% end %>
      </div>
    </div>

    <% if item %>
      <div class="max-w-[520px]">
        <%= render "shared/lookback_timeline", size: :small, timeline: Fogbell::LookbackTimeline.new(
              ard: assessment.ard, lookback_days: finding&.dig("window", "days") || item.lookback_days,
              evidence: finding&.dig("evidence") || [], outside_window_evidence: finding&.dig("outside_window_evidence") || []
            ) %>
      </div>
    <% end %>

    <div class="text-sm leading-relaxed text-body [text-wrap:pretty]">
      <%= finding ? truncate(finding["rationale"], length: 220, separator: " ") : "No pre-run check for this window yet." %>
    </div>
  </div>

  <div class="flex flex-col justify-between gap-4 bg-paper px-6 py-5">
    <div class="flex flex-col gap-0.5">
      <% if days <= 1 %>
        <div class="flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-[.06em] text-closing"><%= glyph(:triangle) %>Closes</div>
        <div class="text-[28px] font-semibold leading-none tracking-tight text-closing"><%= days <= 0 ? "today" : "tomorrow" %></div>
        <div class="mt-1 text-xs text-muted">Charting today still counts</div>
      <% else %>
        <div class="flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-[.06em] text-meta"><%= glyph(:triangle) %>Closes</div>
        <div class="text-[28px] font-semibold leading-none tracking-tight">in <%= days %> days</div>
        <div class="mt-1 text-xs text-muted"><%= assessment.ard.strftime("%a, %b %-d") %></div>
      <% end %>
    </div>
    <div class="flex items-center gap-2">
      <%= primary_button "Open check", new_check_path(assessment_id: assessment.id) %>
      <% if item %><%= secondary_button "See the rule →", rulebook_item_path(item.item_id) %><% end %>
    </div>
  </div>
</article>
