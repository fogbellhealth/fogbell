<% content_for :title, "Fogbell — #{@resident.label}" %>

<div class="mb-6">
  <%= link_to "← Residents", residents_path, class: "text-sm text-muted hover:text-body" %>
</div>

<div class="mb-6">
  <p class="text-[11px] font-semibold uppercase tracking-[.06em] text-muted">Synthetic data</p>
  <h1 class="mt-1 text-3xl font-semibold leading-none tracking-tight"><%= @resident.label %></h1>
</div>

<section class="mb-8">
  <h2 class="mb-2 text-[11px] font-semibold uppercase tracking-[.06em] text-muted">Assessments</h2>
  <div class="divide-y divide-rule rounded border border-rule bg-white">
    <% @resident.assessments.order(ard: :desc).each do |a| %>
      <%= link_to assessment_path(a), class: "flex items-center justify-between gap-3 px-4 py-2.5 hover:bg-ground" do %>
        <span><%= a.assessment_type.tr("_", " ").capitalize %> <span class="text-muted">— ARD <%= a.ard.strftime("%b %-d, %Y") %></span></span>
        <%= a.open? ? deadline_badge(a.days_remaining) : badge("closed", label: "Closed #{a.ard.strftime('%b %-d')}") %>
      <% end %>
    <% end %>
  </div>
</section>

<section>
  <h2 class="mb-2 text-[11px] font-semibold uppercase tracking-[.06em] text-muted">Chart</h2>
  <pre class="whitespace-pre-wrap rounded border border-rule bg-white p-4 font-mono text-xs text-body"><%= @resident.chart_text %></pre>
</section>
