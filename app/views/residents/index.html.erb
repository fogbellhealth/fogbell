<% content_for :title, "Fogbell — residents" %>

<div class="mb-7 flex flex-col gap-1">
  <p class="text-[13px] font-medium text-muted"><%= current_user.facility&.name %></p>
  <h1 class="text-3xl font-semibold leading-none tracking-tight">Residents</h1>
</div>

<div class="flex flex-col rounded border border-rule bg-white">
  <% @residents.each do |resident| %>
    <%= link_to resident_path(resident), class: "flex items-center justify-between gap-3 border-b border-rule px-6 py-4 last:border-b-0 hover:bg-ground" do %>
      <span class="text-[17px] font-semibold"><%= resident.label %></span>
      <span class="text-sm text-muted"><%= pluralize(resident.assessments.count, "assessment") %></span>
    <% end %>
  <% end %>
</div>
