<div id="status" class="text-sm">
  <% case check.status
     when "queued", "running" %>
    <span class="inline-flex items-center gap-2 rounded-md bg-slate-100 px-3 py-1 text-slate-700"><span class="h-2 w-2 animate-pulse rounded-full bg-slate-500"></span>Checking the chart…</span>
  <% when "done" %>
    <span class="rounded-md bg-emerald-50 px-3 py-1 text-emerald-800 ring-1 ring-inset ring-emerald-200">Check complete — draft for nurse review</span>
  <% when "failed" %>
    <div class="max-w-md rounded-md border border-rose-200 bg-rose-50 px-3 py-2 text-rose-900"><strong>The check could not be completed.</strong> <%= check.error %> <%= link_to "Try again", new_check_path, class: "underline" %>.</div>
  <% end %>
</div>
