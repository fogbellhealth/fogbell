<div id="status" class="text-sm">
  <% case check.status
     when "queued", "running" %>
    <span class="inline-flex items-center gap-2 rounded border border-rule px-3 py-1 text-body"><span class="h-2 w-2 animate-pulse rounded-full bg-muted"></span>Checking the chart…</span>
  <% when "done" %>
    <%= badge("verified", label: "Check complete — draft for nurse review") %>
  <% when "failed" %>
    <div class="max-w-md rounded border border-closing px-3 py-2 text-closing"><strong>The check could not be completed.</strong> <%= check.error %> <%= link_to "Try again", new_check_path, class: "underline" %>.</div>
  <% end %>
</div>
