<% if check.done? %>
  <% proj = audit_projection(check) %>
  <section class="rounded-lg border border-slate-200 bg-white p-5 text-sm leading-relaxed text-slate-800">
    <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-500">Mock audit projection</h2>
    <% if proj.available? && proj.checked.positive? %>
      <% src = ->(s) { tag.span("(#{cite(s)})", class: "text-slate-500") } %>
      <p class="mt-2">
        If this record were sampled under the state's MDS assessment review<% if proj.sample %> (<%= proj.sample.value[:pct] %>% sample, minimum <%= proj.sample.value[:min_records] %> records <%= src.call(proj.sample.source) %>)<% end %>,
        <strong><%= proj.unsupported %> of <%= proj.checked %></strong> checked items lack supporting documentation<% if proj.partial.positive? %> and <%= proj.partial %> <%= proj.partial == 1 ? "is" : "are" %> partially supported<% end %>:
        a projected error rate of <strong><%= proj.error_rate_pct %>%</strong>
        <% if proj.tier %>
          — at or above the <%= proj.tier.error_rate_min %>% threshold for a <strong><%= proj.tier.reduction_pct %>% Direct Care Rate reduction</strong> <%= src.call(proj.tier.source) %>.
        <% elsif proj.next_tier %>
          — below the <%= proj.next_tier.error_rate_min %>% threshold for a <%= proj.next_tier.reduction_pct %>% Direct Care Rate reduction <%= src.call(proj.next_tier.source) %>.
        <% end %>
        <% if proj.correction_days %>Corrections must be completed within <%= proj.correction_days.value %> days of a written request <%= src.call(proj.correction_days.source) %>.<% end %>
      </p>
      <p class="mt-2 text-xs text-slate-500">Illustrative projection for this single record; actual reviews sample across records. Method: unsupported items count 1, partially supported items count <%= Fogbell::EvidenceCheck::AuditProjection::PARTIAL_WEIGHT %>, not-applicable items are excluded. Thresholds are read from the cited state rule text; nothing is assumed.<%= jurisdiction_badge(proj.tier&.source || proj.tiers.first.source) %></p>
    <% elsif proj.checked.zero? %>
      <p class="mt-2 text-slate-600">No checkable items in this record.</p>
    <% else %>
      <p class="mt-2 text-slate-600">No state review machinery is available in the rulebook for this instrument yet, so no projection is shown. <%= proj.unsupported %> of <%= proj.checked %> checked items lack supporting documentation.</p>
    <% end %>
  </section>
<% end %>
