<% content_for :title, "Fogbell — check ##{@check.id}" %>
<%= turbo_stream_from @check %>

<div class="flex flex-col gap-6">
  <div class="flex items-baseline justify-between">
    <p class="flex items-center gap-2 text-[13px] text-muted">
      <%= link_to "Today", today_path %><span>›</span><span class="font-semibold text-ink">Evidence check ARD <%= @check.ard.strftime("%b %-d, %Y") %></span>
    </p>
    <%= render "checks/status", check: @check %>
  </div>

  <div id="banner"><%= render "checks/banner", check: @check %></div>

  <div id="cards" class="flex flex-col gap-10">
    <% @check.results.each do |result| %>
      <%= render "checks/card", result: result, check: @check, rule_set: rule_set_for(@check) %>
    <% end %>
  </div>

  <p class="text-xs text-muted">Synthetic data only. Every card is a draft for nurse review; expand "Why?" to see the rules applied with their citations. <%= link_to "start another", new_check_path, class: "underline decoration-rule hover:decoration-muted" %></p>
</div>
