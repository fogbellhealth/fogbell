<% content_for :title, "Fogbell — sign in" %>

<div class="mx-auto max-w-sm">
  <div class="mb-6 text-center">
    <span class="text-3xl" aria-hidden="true">🔔</span>
    <h1 class="mt-2 text-xl font-semibold tracking-tight text-slate-900">Sign in to Fogbell</h1>
    <p class="mt-1 text-sm text-slate-500">Facility and rulebook accounts land on different pages — that's deliberate.</p>
  </div>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4 rounded-lg border border-slate-200 bg-white p-6" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, class: "block text-sm font-medium text-slate-800" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
    </div>

    <div>
      <%= f.label :password, class: "block text-sm font-medium text-slate-800" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <label class="flex items-center gap-2 text-sm text-slate-600">
        <%= f.check_box :remember_me, class: "rounded border-slate-300" %>
        <%= f.label :remember_me, "Remember me", class: "!mb-0" %>
      </label>
    <% end %>

    <%= f.submit "Sign in", class: "w-full rounded-md bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-slate-800" %>
  <% end %>
</div>
