<% content_for :title, "Fogbell — sign in" %>

<div class="mx-auto max-w-sm">
  <div class="mb-6 text-center">
    <span class="text-3xl" aria-hidden="true">🔔</span>
    <h1 class="mt-2 text-xl font-semibold tracking-tight">Sign in to Fogbell</h1>
    <p class="mt-1 text-sm text-muted">Facility and rulebook accounts land on different pages — that's deliberate.</p>
  </div>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "flex flex-col gap-4 rounded border border-rule bg-white p-6" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, class: "block text-sm font-medium text-ink" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "mt-1 block w-full rounded border border-rule px-3 py-2 text-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" %>
    </div>

    <div>
      <%= f.label :password, class: "block text-sm font-medium text-ink" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "mt-1 block w-full rounded border border-rule px-3 py-2 text-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <label class="flex items-center gap-2 text-sm text-body">
        <%= f.check_box :remember_me, class: "rounded border-rule text-ink" %>
        <%= f.label :remember_me, "Remember me", class: "!mb-0" %>
      </label>
    <% end %>

    <%= f.submit "Sign in", class: DesignSystemHelper::PRIMARY_BUTTON + " w-full py-2.5" %>
  <% end %>
</div>
