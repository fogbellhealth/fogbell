<% content_for :title, "Fogbell — the rulebook" %>

<div class="flex flex-col gap-7">
  <div class="max-w-3xl">
    <h1 class="text-3xl font-semibold leading-none tracking-tight">The rulebook</h1>
    <p class="mt-2 text-sm leading-relaxed text-body">Every promoted rule, cited to a document and a page. This is the asset the evidence checker runs on — nothing here is invented, and anything the corpus doesn't say is marked so, not filled in.</p>
  </div>

  <%= render "shared/metric_group", metrics: [
        { label: "Promoted items", value: @counts[:total] },
        { label: "With a state layer", value: @counts[:with_state_layers] },
        { label: "With a conflict", value: @counts[:with_conflicts] },
        { label: "Pending expert review", value: @counts[:pending_review] }
      ] %>

  <div class="flex flex-wrap items-center gap-2 text-sm">
    <span class="text-muted">Jurisdiction:</span>
    <%= link_to "All", rulebook_path(status: params[:status]), class: "rounded px-2 py-1 #{params[:jurisdiction].blank? ? 'bg-ink text-white' : 'text-body hover:bg-ground'}" %>
    <% @jurisdictions.each do |j| %>
      <%= link_to j, rulebook_path(jurisdiction: j, status: params[:status]), class: "rounded px-2 py-1 #{params[:jurisdiction] == j ? 'bg-ink text-white' : 'text-body hover:bg-ground'}" %>
    <% end %>
    <span class="ml-4 text-muted">Review status:</span>
    <%= link_to "All", rulebook_path(jurisdiction: params[:jurisdiction]), class: "rounded px-2 py-1 #{params[:status].blank? ? 'bg-ink text-white' : 'text-body hover:bg-ground'}" %>
    <% @statuses.each do |s| %>
      <%= link_to s.tr("_", " "), rulebook_path(jurisdiction: params[:jurisdiction], status: s), class: "rounded px-2 py-1 #{params[:status] == s ? 'bg-ink text-white' : 'text-body hover:bg-ground'}" %>
    <% end %>
    <%= link_to "Cross-jurisdiction view →", rulebook_jurisdictions_path, class: "ml-auto rounded bg-window px-3 py-1.5 text-xs font-semibold text-ink" %>
  </div>

  <% if @grouped.empty? %>
    <p class="text-sm text-muted">No items match this filter.</p>
  <% end %>

  <% @grouped.each do |instrument, sections| %>
    <section>
      <h2 class="mb-3 text-lg font-semibold"><%= instrument_name(instrument) %></h2>
      <% sections.each do |section, items| %>
        <div class="mb-5">
          <h3 class="mb-2 text-[11px] font-semibold uppercase tracking-[.06em] text-muted">Section <%= section %></h3>
          <div class="divide-y divide-rule rounded border border-rule bg-white">
            <% items.each do |item| %>
              <%= link_to rulebook_item_path(item.item_id), class: "flex items-center justify-between gap-3 px-4 py-2.5 hover:bg-ground" do %>
                <span class="min-w-0">
                  <span class="font-mono text-xs font-semibold text-ink"><%= item.item_id %></span>
                  <span class="ml-2 text-sm text-body"><%= item.item_name %></span>
                </span>
                <span class="flex shrink-0 items-center gap-2">
                  <% j = item_jurisdiction(item) %>
                  <% if j != "Federal" %><%= badge("provisional", label: j) %><% end %>
                  <% if item.conflicts.any? %><span class="flex items-center gap-1 text-[11px] font-medium text-body"><%= glyph(:square_outline) %>conflict</span><% end %>
                  <%= provenance_badge(effective_review_status(item)) %>
                </span>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </section>
  <% end %>
</div>
