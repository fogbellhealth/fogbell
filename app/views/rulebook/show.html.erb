<% content_for :title, "Fogbell — #{@item.item_id}" %>
<%
j = item_jurisdiction(@item)
federal_doc = @item.supportive_documentation.fetch("federal", [])
state_doc = @item.supportive_documentation.fetch("state", {})
source_numbers = number_sources(@item)
tag_for = ->(s) { source_tag(s, source_numbers) }
%>

<div class="flex flex-col gap-8">
  <div class="flex flex-col gap-3 border-b border-ink pb-6">
    <div class="flex items-start justify-between gap-6">
      <p class="text-[13px] font-medium text-muted"><%= instrument_name(@item.instrument) %> · Section <%= @item.section %></p>
      <div class="flex shrink-0 items-center gap-2">
        <%= provenance_badge(effective_review_status(@item)) %>
        <% if j != "Federal" %><%= badge("provisional", label: "#{j} layer — provisional pending expert review") %><% end %>
      </div>
    </div>
    <h1 class="text-3xl font-semibold leading-[1.15] tracking-tight"><span class="font-medium text-muted"><%= @item.item_id %></span> <%= @item.item_name %></h1>
    <div class="grid w-fit grid-flow-col gap-x-8 text-[13px]">
      <div class="flex flex-col gap-0.5">
        <div class="text-[11px] font-semibold uppercase tracking-[.06em] text-muted">Instrument</div>
        <div class="font-semibold"><%= instrument_name(@item.instrument) %></div>
      </div>
      <div class="flex flex-col gap-0.5">
        <div class="text-[11px] font-semibold uppercase tracking-[.06em] text-muted">Look-back</div>
        <div class="font-semibold"><%= @item.lookback_days ? "#{@item.lookback_days} days#{' · see conflict' if @item.conflicts.any? { |c| c['topic'].to_s.match?(/window|look-?back|period/i) }}" : "not stated" %></div>
      </div>
      <div class="flex flex-col gap-0.5">
        <div class="text-[11px] font-semibold uppercase tracking-[.06em] text-muted">Jurisdiction</div>
        <div class="font-semibold"><%= j %></div>
      </div>
      <div class="flex flex-col gap-0.5">
        <div class="text-[11px] font-semibold uppercase tracking-[.06em] text-muted">Extracted</div>
        <div class="font-semibold"><%= @item.provenance_summary["extracted_at"] %> · <%= source_numbers.size %> source<%= "s" unless source_numbers.size == 1 %></div>
      </div>
    </div>
    <% if @item.section != "CONV" %>
      <div><%= primary_button "Run a check using this item", new_check_path(check: { item_ids: [ @item.item_id ] }) %></div>
    <% end %>
  </div>

  <% if @item.lookback_days.present? %>
    <div class="grid grid-cols-[160px_1fr] gap-6">
      <div class="pt-0.5 text-[13px] font-semibold text-muted">Illustration</div>
      <div>
        <p class="mb-2 text-xs text-muted">Example dates, not real evidence — illustrates this item's <%= @item.lookback_days %>-day window.</p>
        <% illustrative_ard = Date.current + 1 %>
        <%= render "shared/lookback_timeline", size: :standalone, timeline: Fogbell::LookbackTimeline.new(
              ard: illustrative_ard, lookback_days: @item.lookback_days,
              evidence: [ { "date" => (illustrative_ard - 1).iso8601, "author" => "example", "quote" => "a supporting note, counted" } ],
              outside_window_evidence: [ { "date" => (illustrative_ard - @item.lookback_days).iso8601, "author" => "example", "quote" => "documented too early to count" } ]
            ) %>
      </div>
    </div>
  <% end %>

  <% if @item.coding_levels.any? %>
    <div class="grid grid-cols-[160px_1fr] gap-6">
      <div class="pt-0.5 text-[13px] font-semibold text-muted">§1 Coding levels</div>
      <div class="grid grid-cols-[48px_1fr_1fr] border-t border-ink text-sm">
        <% @item.coding_levels.each do |l| %>
          <div class="border-b border-rule py-2.5 font-semibold"><%= l["code"] %></div>
          <div class="border-b border-rule px-3 py-2.5 font-semibold"><%= l["label"] %></div>
          <div class="border-b border-rule py-2.5 text-body"><%= l["definition"] %> <%= tag_for.call(l["source"]) %></div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-[160px_1fr] gap-6">
    <div class="pt-0.5 text-[13px] font-semibold text-muted">§2 Coding rules</div>
    <% if @item.federal_coding_rules.empty? %>
      <p class="text-sm text-muted">Not stated in the source.</p>
    <% else %>
      <div class="flex flex-col gap-3 text-sm leading-[1.55]">
        <% @item.federal_coding_rules.each_with_index do |r, i| %>
          <div class="grid grid-cols-[28px_1fr] gap-2">
            <div class="font-semibold text-muted">2.<%= i + 1 %></div>
            <div><%= r["rule"] %> <%= tag_for.call(r["source"]) %></div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="grid grid-cols-[160px_1fr] gap-6">
    <div class="pt-0.5 text-[13px] font-semibold text-muted">§3 Documentation criteria</div>
    <% if federal_doc.empty? && state_doc.values.all?(&:empty?) %>
      <p class="text-sm text-muted">Not stated in the source.</p>
    <% else %>
      <div class="flex flex-col gap-3 text-sm leading-[1.55]">
        <% federal_doc.each_with_index do |c, i| %>
          <div class="grid grid-cols-[28px_1fr] gap-2">
            <div class="font-semibold text-muted">3.<%= i + 1 %></div>
            <div><%= c["criterion"] %> <%= tag_for.call(c["source"]) %></div>
          </div>
        <% end %>
        <% state_doc.each do |st, criteria| %>
          <% criteria.each do |c| %>
            <div class="grid grid-cols-[28px_1fr] gap-2">
              <div></div>
              <div><%= c["criterion"] %> <%= badge("provisional", label: "#{st} layer — provisional pending expert review") %> <%= tag_for.call(c["source"]) %></div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% @item.conflicts.each_with_index do |c, idx| %>
    <div class="grid grid-cols-[160px_1fr] gap-6">
      <div class="pt-0.5 text-[13px] font-semibold text-muted"><%= idx.zero? ? "§4 Conflicts between sources" : "" %></div>
      <div class="flex flex-col rounded border border-rule bg-white">
        <div class="flex items-center justify-between gap-3 border-b border-rule px-5 py-3.5 text-sm font-semibold">
          <div><%= c["topic"] %></div>
          <div class="text-xs font-semibold text-body">Unresolved · <%= c["resolution"] %></div>
        </div>
        <div class="grid grid-cols-2">
          <% c["positions"].each_with_index do |pos, i| %>
            <div class="flex flex-col gap-1.5 px-5 py-4 <%= 'border-r border-rule' if i.zero? %>">
              <div class="text-[11px] font-semibold uppercase tracking-[.06em] text-muted">Position <%= (65 + i).chr %> · <%= tag_for.call(pos["source"]) %></div>
              <div class="text-sm leading-relaxed"><%= pos["claim"] %></div>
              <div class="text-xs font-semibold text-meta"><%= cite(pos["source"]) %></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <% if @item.not_found.any? %>
    <div class="grid grid-cols-[160px_1fr] gap-6">
      <div class="pt-0.5 text-[13px] font-semibold text-muted">§5 Not stated in the sources</div>
      <div class="flex flex-col gap-2 text-sm leading-[1.55] text-body">
        <% @item.not_found.each do |k| %>
          <div class="grid grid-cols-[16px_1fr] gap-2"><div class="text-faint">—</div><div><%= not_found_label(k) %></div></div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-[160px_1fr] gap-6">
    <div class="pt-0.5 text-[13px] font-semibold text-muted">§6 Sources</div>
    <div class="flex flex-col gap-3">
      <% source_numbers.sort_by { |_, n| n }.each do |key, n| %>
        <% doc, loc, quote = key %>
        <div class="grid grid-cols-[32px_1fr] gap-3">
          <div class="pt-3.5 text-xs font-semibold text-muted">S<%= n %></div>
          <%= render "shared/citation", source: { "doc" => doc, "loc" => loc, "quote" => quote } %>
        </div>
      <% end %>
    </div>
  </div>

  <% if @item.case_mix_relevance["level"] != "unknown" %>
    <div class="grid grid-cols-[160px_1fr] gap-6">
      <div class="pt-0.5 text-[13px] font-semibold text-muted">§7 Case-mix relevance</div>
      <div class="text-sm leading-relaxed text-body"><strong class="capitalize text-ink"><%= @item.case_mix_relevance["level"] %></strong> — <%= @item.case_mix_relevance["notes"] %><% if @item.case_mix_relevance["source"] %> <%= tag_for.call(@item.case_mix_relevance["source"]) %><% end %></div>
    </div>
  <% end %>

  <% if @item.common_audit_citations.any? %>
    <div class="grid grid-cols-[160px_1fr] gap-6">
      <div class="pt-0.5 text-[13px] font-semibold text-muted">§8 Common audit citations</div>
      <div class="flex flex-col gap-1.5 text-sm text-body">
        <% @item.common_audit_citations.each do |c| %>
          <div><span class="font-mono text-xs text-muted"><%= c["citation"] %></span> — <%= c["notes"] %></div>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @item.state_deltas.any? %>
    <div class="grid grid-cols-[160px_1fr] gap-6">
      <div class="pt-0.5 text-[13px] font-semibold text-muted">§9 State differences</div>
      <div class="flex flex-col gap-2 text-sm leading-relaxed text-body">
        <% @item.state_deltas.each do |d| %>
          <div><strong class="text-ink"><%= d["state"] %>:</strong> <%= d["delta"] %> <span class="text-xs font-semibold text-meta"><%= cite(d["source"]) %></span></div>
        <% end %>
      </div>
    </div>
  <% end %>
  </div>
</div>
