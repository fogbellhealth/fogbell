<% content_for :title, "Fogbell — standing questions" %>

<div class="mb-8 max-w-3xl">
  <%= link_to "← Review queue", review_path, class: "text-sm text-slate-500 hover:text-slate-700" %>
  <h1 class="mt-3 text-2xl font-semibold tracking-tight text-slate-900">Standing questions</h1>
  <p class="mt-2 text-sm leading-relaxed text-slate-600">Things the corpus does not settle on its own and can't be decided from a desk. Each section needs a different qualified reviewer — they aren't interchangeable.</p>
</div>

<% @sections.each do |section| %>
  <section class="mb-8 rounded-lg border border-slate-200 bg-white p-5">
    <div class="mb-3 flex items-center gap-2">
      <h2 class="text-base font-semibold text-slate-900"><%= section.title %></h2>
      <% if section.title.include?("New York") %>
        <span class="rounded bg-violet-50 px-2 py-0.5 text-[11px] font-medium text-violet-800 ring-1 ring-inset ring-violet-200">needs a New York-qualified reviewer</span>
      <% else %>
        <span class="rounded bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-600">the Maine Verifier</span>
      <% end %>
    </div>
    <p class="mb-4 text-sm text-slate-600"><%= section.intro %></p>
    <ol class="space-y-3">
      <% section.items.each do |item| %>
        <li class="flex gap-2 text-sm text-slate-800">
          <span class="shrink-0 font-mono text-xs text-slate-400">Q<%= item.number %></span>
          <span><%= item.html %></span>
        </li>
      <% end %>
    </ol>
  </section>
<% end %>
