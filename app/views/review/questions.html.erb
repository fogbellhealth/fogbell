<% content_for :title, "Fogbell — standing questions" %>
<% content_for :dark_header, true %>
<% content_for :header_subtitle, "Standing questions" %>

<div class="flex flex-col gap-6 px-8 py-9">
  <div class="max-w-3xl">
    <%= link_to "← Review queue", review_path, class: "text-sm text-muted hover:text-body" %>
    <h1 class="mt-3 text-3xl font-semibold leading-none tracking-tight">Standing questions</h1>
    <p class="mt-2 text-sm leading-relaxed text-body">Things the corpus does not settle on its own and can't be decided from a desk. Each section needs a different qualified reviewer — they aren't interchangeable.</p>
  </div>

  <% @sections.each do |section| %>
    <section class="rounded border border-rule bg-white p-5">
      <div class="mb-3 flex items-center gap-2">
        <h2 class="text-base font-semibold">
          <%= section.title %>
        </h2>
        <% if section.title.include?("New York") %>
          <%= badge("provisional", label: "needs a New York-qualified reviewer") %>
        <% else %>
          <span class="rounded border border-rule px-2 py-0.5 text-[11px] font-medium text-meta">the Maine Verifier</span>
        <% end %>
      </div>
      <p class="mb-4 text-sm text-body"><%= section.intro %></p>
      <ol class="space-y-3">
        <% section.items.each do |item| %>
          <li class="flex gap-2 text-sm">
            <span class="shrink-0 font-mono text-xs text-muted">Q<%= item.number %></span>
            <span><%= item.html %></span>
          </li>
        <% end %>
      </ol>
    </section>
  <% end %>
</div>
