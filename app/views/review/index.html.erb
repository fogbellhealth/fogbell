<% content_for :title, "Fogbell — review queue" %>

<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <div class="max-w-2xl">
    <h1 class="text-2xl font-semibold tracking-tight text-slate-900">Review queue</h1>
    <p class="mt-2 text-sm leading-relaxed text-slate-600">Every extracted rule is a draft until a qualified reviewer checks it against the source. This replaces the markdown packets — the same plain-English rendering, with a submit button.</p>
  </div>
  <%= link_to "Standing questions →", review_questions_path, class: "shrink-0 rounded-md bg-violet-50 px-3 py-1.5 text-xs font-semibold text-violet-800 ring-1 ring-inset ring-violet-200 hover:bg-violet-100" %>
</div>

<div class="mb-6 flex flex-wrap gap-2 text-sm">
  <% %w[unreviewed in_review verified disputed all].each do |s| %>
    <%= link_to review_path(status: s), class: "rounded-md px-2.5 py-1 #{@status == s ? 'bg-slate-900 text-white' : 'text-slate-600 hover:bg-slate-100'}" do %>
      <%= s.tr("_", " ") %><span class="ml-1 text-xs opacity-70">(<%= s == "all" ? @counts.values.sum : @counts.fetch(s, 0) %>)</span>
    <% end %>
  <% end %>
</div>

<% if @items.empty? %>
  <p class="text-sm text-slate-500">Nothing in this queue.</p>
<% else %>
  <div class="divide-y divide-slate-100 rounded-lg border border-slate-200 bg-white">
    <% @items.each do |item| %>
      <%= link_to review_item_path(item.item_id), class: "flex items-center justify-between gap-3 px-4 py-2.5 hover:bg-slate-50" do %>
        <span class="min-w-0">
          <span class="font-mono text-xs font-semibold text-slate-700"><%= item.item_id %></span>
          <span class="ml-2 text-sm text-slate-800"><%= item.item_name %></span>
        </span>
        <span class="flex shrink-0 items-center gap-2">
          <% j = item_jurisdiction(item) %>
          <% if j != "Federal" %><span class="rounded bg-violet-50 px-1.5 py-0.5 text-[11px] font-medium text-violet-800 ring-1 ring-inset ring-violet-200"><%= j %></span><% end %>
          <%= review_status_badge(item.provenance_summary["expert_review_status"]) %>
        </span>
      <% end %>
    <% end %>
  </div>
<% end %>
