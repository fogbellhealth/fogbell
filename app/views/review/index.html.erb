<% content_for :title, "Fogbell — review queue" %>
<% content_for :dark_header, true %>
<% content_for :header_subtitle, "0 rules awaiting judgment" %>

<div class="flex flex-col items-start gap-4 px-8 py-9">
  <p class="text-sm text-body">Nothing in the <strong><%= @status %></strong> queue.</p>
  <div class="flex gap-2 text-sm font-semibold text-meta">
    <%= link_to "Unreviewed", review_path(status: "unreviewed") %>
    <%= link_to "Pending", review_path(status: "pending") %>
    <%= link_to "All", review_path(status: "all") %>
  </div>
  <%= link_to "Standing questions →", review_questions_path, class: "text-sm font-semibold text-ink" %>
</div>
