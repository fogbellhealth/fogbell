<% content_for :title, "Fogbell — review #{@item.item_id}" %>
<% content_for :dark_header, true %>
<% content_for :header_subtitle, "#{@counts.values_at('unreviewed', 'pending', 'in_review').compact.sum} rules awaiting judgment" %>
<%
federal_doc = @item.supportive_documentation.fetch("federal", [])
source_numbers = number_sources(@item)
position = @items.index { |i| i.item_id == @item.item_id }
%>

<div class="grid min-h-[640px] grid-cols-[300px_1fr]">
  <!-- queue -->
  <div class="flex flex-col border-r border-rule bg-white">
    <div class="flex items-center justify-between border-b border-rule px-5 py-3.5">
      <div class="text-[11px] font-semibold uppercase tracking-[.06em] text-muted">Queue · oldest first</div>
      <div class="flex gap-2 text-xs font-semibold text-meta">
        <%= link_to "Unreviewed", review_path(status: "unreviewed"), class: @status == "unreviewed" ? "text-ink" : "" %>
        <%= link_to "Pending", review_path(status: "pending"), class: @status == "pending" ? "text-ink" : "" %>
        <%= link_to "All", review_path(status: "all"), class: @status == "all" ? "text-ink" : "" %>
      </div>
    </div>
    <% @items.first(30).each do |item| %>
      <% selected = item.item_id == @item.item_id %>
      <%= link_to review_item_path(item.item_id, status: @status), class: "flex flex-col gap-1 border-b border-rule px-5 py-3.5 #{selected ? 'border-l-[3px] border-l-ink bg-window' : 'hover:bg-ground'}" do %>
        <div class="text-sm font-semibold"><span class="font-medium text-muted"><%= item.item_id %></span> <%= item.item_name %></div>
        <div class="flex items-center gap-2.5 text-xs text-body">
          <%= provenance_badge(effective_review_status(item)) %>
          <span><%= pluralize(number_sources(item).size, "source") %></span>
        </div>
      <% end %>
    <% end %>
    <% if @items.size > 30 %><div class="px-5 py-3.5 text-xs text-muted"><%= @items.size - 30 %> more</div><% end %>
  </div>

  <!-- judgment -->
  <div class="flex flex-col gap-6 px-8 pb-9 pt-7">
    <div class="flex items-start justify-between gap-6 border-b border-ink pb-4">
      <div class="flex flex-col gap-1">
        <div class="text-[13px] text-muted">Rule <%= position ? position + 1 : "?" %> of <%= @items.size %> · <%= instrument_name(@item.instrument) %> Section <%= @item.section %></div>
        <div class="text-2xl font-semibold leading-[1.15] tracking-tight"><span class="font-medium text-muted"><%= @item.item_id %></span> <%= @item.item_name %></div>
      </div>
      <%= secondary_button "Open full rule →", rulebook_item_path(@item.item_id) %>
    </div>

    <%= form_with url: review_item_path(@item.item_id, status: @status), method: :post, class: "flex flex-col gap-8" do %>
      <% if @item.federal_coding_rules.any? %>
        <div class="flex flex-col gap-2">
          <div class="text-[11px] font-semibold uppercase tracking-[.06em] text-muted">Plain-English rendering · as Fogbell applies it · <%= @item.federal_coding_rules.size %> rules</div>
        </div>
        <% @item.federal_coding_rules.each_with_index do |r, i| %>
          <div class="flex flex-col gap-3 border-t border-rule pt-6 first:border-t-0 first:pt-0">
            <div class="flex items-center gap-2">
              <div class="text-base font-semibold leading-[1.55]">R<%= i + 1 %>. <%= r["rule"] %></div>
              <%= source_tag(r["source"], source_numbers) %>
            </div>
            <div class="grid grid-cols-2 gap-2.5">
              <%= render "shared/citation", source: r["source"] %>
            </div>
            <%= render "verdict_fields", name: "rules[#{i}]" %>
          </div>
        <% end %>
      <% end %>

      <% federal_doc.each_with_index do |c, i| %>
        <div class="flex flex-col gap-3 border-t border-rule pt-6">
          <div class="flex items-center gap-2">
            <div class="text-base font-semibold leading-[1.55]">Documentation criterion <%= i + 1 %>. <%= c["criterion"] %></div>
            <%= source_tag(c["source"], source_numbers) %>
            <% if c["verified_by_expert"] %><%= badge("verified") %><% end %>
          </div>
          <div class="grid grid-cols-2 gap-2.5">
            <%= render "shared/citation", source: c["source"] %>
          </div>
          <%= render "verdict_fields", name: "criteria[#{i}]" %>
        </div>
      <% end %>

      <% if @item.conflicts.any? %>
        <div class="flex items-center gap-2 text-[13px] text-body">
          <%= glyph(:square_outline) %><%= pluralize(@item.conflicts.size, "conflict") %> between sources — see the full rule for both positions.
        </div>
      <% end %>

      <div class="flex flex-col gap-2">
        <label class="text-[11px] font-semibold uppercase tracking-[.06em] text-muted">Notes · optional, applies to the whole submission</label>
        <textarea name="overall_notes" rows="3" placeholder="Anything the next reviewer or the extraction team should know." class="min-h-16 rounded border border-rule bg-white px-4 py-3 text-sm text-ink placeholder:text-faint focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"></textarea>
      </div>

      <div class="flex items-center justify-between gap-3 border-t border-rule pt-4">
        <div class="text-xs text-muted">Your judgment is recorded with your name and date. It's applied to the rulebook only after <code class="rounded bg-ground px-1 py-0.5">rake rulebook:apply_review</code> runs.</div>
        <div class="flex items-center gap-2">
          <%= secondary_button "Skip for now", review_path(status: @status) %>
          <button type="submit" class="<%= DesignSystemHelper::PRIMARY_BUTTON %>">Submit judgment</button>
        </div>
      </div>
    <% end %>
  </div>
</div>
